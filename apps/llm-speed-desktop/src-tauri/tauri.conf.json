{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Local LLM Speed Lab",
  "version": "0.1.0",
  "identifier": "lab.local-llm-bench.speed",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local LLM Speed Lab",
        "width": 1240,
        "height": 840,
        "minWidth": 920,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
